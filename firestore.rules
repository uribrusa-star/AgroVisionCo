rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Obtener los datos del usuario logueado en la colección users
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verificar si el usuario es SuperAdmin
    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'SuperAdmin' || 
        getUserData().establishmentId == 'main'
      );
    }

    // Obtener el establecimiento del usuario autenticado
    function getUserEstablishment() {
      return getUserData().establishmentId;
    }

    // Regla de aislamiento multi-inquilino (tenant)
    function belongsToTenant(data) {
      return isSuperAdmin() || (
        isAuthenticated() && 
        data.establishmentId == getUserEstablishment()
      );
    }

    // Por defecto, denegamos todo el acceso no contemplado explícitamente
    match /{document=**} {
      allow read, write: if false;
    }

    // Reglas para la colección users:
    // - Un usuario puede leer su propio perfil, los usuarios de su mismo establecimiento, o SuperAdmin
    // - Un usuario puede editar su propio perfil básico, o SuperAdmin / Productor de su establecimiento
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        resource.data.establishmentId == getUserEstablishment()
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.establishmentId == getUserEstablishment()
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
        (resource.data.establishmentId == getUserEstablishment() && getUserData().role == 'Productor')
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.establishmentId == getUserEstablishment() && getUserData().role == 'Productor')
      );
    }

    // Reglas para el documento de establecimiento:
    match /establishment/{estId} {
      allow read: if isAuthenticated() && (
        estId == getUserEstablishment() ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        (estId == getUserEstablishment() && getUserData().role == 'Productor')
      );
    }

    // Colecciones operativas multi-inquilino (aisladas por establishmentId)
    match /collectors/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /packers/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /harvests/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /packagingLogs/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /culturalPracticeLogs/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /agronomistLogs/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /phenologyLogs/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /predictionLogs/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /diagnosisLogs/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /supplies/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /tasks/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /batches/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /collectorPaymentLogs/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /producerLogs/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /transactions/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /notifications/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /attendanceLogs/{doc} {
      allow read: if isAuthenticated() && belongsToTenant(resource.data);
      allow create: if isAuthenticated() && belongsToTenant(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToTenant(resource.data);
    }
    match /auditLogs/{doc} {
      allow read, write: if isAuthenticated() && (
        isSuperAdmin() || 
        (resource != null && belongsToTenant(resource.data)) ||
        (request.resource != null && belongsToTenant(request.resource.data))
      );
    }

    // Colección de conocimiento agronómico global (lectura para autenticados, escritura admin)
    match /knowledge/{doc} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Configuración y solicitudes internas administrativas
    match /platformSettings/{doc} {
      allow read, write: if isSuperAdmin();
    }
    match /contactRequests/{doc} {
      allow read, write: if isSuperAdmin();
    }
  }
}
